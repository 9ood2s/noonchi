# Copy to .env.local; use your own project and API accounts.
# Never put real credentials in this example or commit .env.local.

# Canonical URLs, sitemap, OAuth callback and www redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: your own URL and public key, required for builds and hosted features.
# local:dev reads the local CLI credentials instead of these hosted values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# NAVER Maps browser SDK. Register your own allowed domains.
NEXT_PUBLIC_NCP_MAPS_CLIENT_ID=
NEXT_PUBLIC_NCP_MAP_STYLE_LIGHT=
NEXT_PUBLIC_NCP_MAP_STYLE_DARK=

# SERVER ONLY: NAVER Maps directions/geocoding.
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=

# SERVER ONLY: Kakao Local / transit.
KAKAO_REST_KEY=

# CLI data collection only; not required to build bundled public school data.
NEIS_API_KEY=
SCHOOLINFO_API_KEY=

# Optional related-service links. Empty = hidden.
NEXT_PUBLIC_SUPAPAD_URL=
NEXT_PUBLIC_SUPACLASS_URL=
