# Copy to .env.local; use your own project and API accounts.
# Never put real credentials in this example or commit .env.local.

# Canonical URLs, sitemap, OAuth callback and www redirect.
# Use your own HTTPS origin when deploying; no trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: your NEW Cloud project or self-hosted instance; required by this app.
# This is an HTTP API URL, not a PostgreSQL connection string.
# Apply supabase/migrations first; see docs/SELF_HOSTING.md.
# local:dev reads the local CLI credentials instead of these hosted values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY: your project's service_role key (or secret key); bypasses RLS.
# Used for view-count writes and commute caching. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# NAVER Maps browser SDK: enable Web Dynamic Map in your own application.
# Register localhost:3000 and your own deployment's allowed domains.
NEXT_PUBLIC_NCP_MAPS_CLIENT_ID=
# Optional My Style IDs. Empty uses NAVER's default light map.
NEXT_PUBLIC_NCP_MAP_STYLE_LIGHT=
NEXT_PUBLIC_NCP_MAP_STYLE_DARK=

# SERVER ONLY: NAVER Maps Directions 5; Geocoding for data-collection scripts.
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=

# SERVER ONLY: Kakao Local address search. This is NOT the Kakao JavaScript key.
# Transit is disabled in lib/features.ts; adding a key does not enable it.
KAKAO_REST_KEY=

# CLI data collection only; not required to build bundled public school data.
NEIS_API_KEY=
SCHOOLINFO_API_KEY=

# Google login: configure your OAuth client ID/secret in Supabase Auth,
# not in NEXT_PUBLIC_* variables. Enable anonymous sign-ins and manual linking.
# NAVER login is hidden by default; see docs/SELF_HOSTING.md before enabling it.

# Optional related-service links. Empty = hidden.
NEXT_PUBLIC_SUPAPAD_URL=
NEXT_PUBLIC_SUPACLASS_URL=
