{
  "name": "run-away",
  "private": true,
  "type": "module",
  "description": "교사 인사이동 정보 서비스 — 경기·인천 초등",
  "scripts": {
    "dev": "next dev",
    "local:up": "supabase start",
    "local:down": "supabase stop --project-id noonchi-local",
    "local:reset": "supabase db reset",
    "local:dev": "node scripts/local-dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "guard:ui": "node scripts/ui-guard.mjs",
    "guard:silent": "node scripts/silent-guard.mjs",
    "guard:touch": "node scripts/touch-reveal-guard.mjs",
    "guard:hooks": "node scripts/hook-order-guard.mjs",
    "guard": "run-p --print-label --aggregate-output guard:ui guard:silent guard:touch guard:hooks",
    "areas": "node scripts/parse-personnel-areas.mjs",
    "areas:incheon": "node scripts/parse-incheon-areas.mjs",
    "grades:incheon": "node scripts/parse-incheon-office-grades.mjs",
    "areas:diff": "node scripts/diff-personnel-areas.mjs",
    "areas:sql": "node scripts/load-personnel-areas.mjs",
    "mig:new": "supabase migration new",
    "verify": "npm run read && npm run match:all && npm run checks && npm run build",
    "neis": "node scripts/fetch-neis-schools.mjs",
    "match": "node scripts/match-neis.mjs",
    "assign:incheon": "node scripts/assign-incheon-areas.mjs",
    "schoolinfo": "node scripts/fetch-schoolinfo.mjs",
    "classes": "node scripts/fetch-classes.mjs",
    "schools": "node scripts/build-schools.mjs",
    "nation": "node scripts/fetch-nation.mjs",
    "selftest": "run-p --print-label --aggregate-output selftest:transfer selftest:incheon selftest:commute",
    "geocode": "node scripts/geocode-missing.mjs",
    "selftest:commute": "node scripts/selftest-commute.mjs",
    "selftest:transfer": "node scripts/selftest-transfer.mjs",
    "selftest:incheon": "node scripts/selftest-incheon.mjs",
    "read:g2026": "node scripts/parse-personnel-areas.mjs 2026",
    "read:g2027": "node scripts/parse-personnel-areas.mjs 2027",
    "read:i2027": "node scripts/parse-incheon-areas.mjs 2027",
    "read:igrade": "node scripts/parse-incheon-office-grades.mjs 2027",
    "read": "run-p --print-label --aggregate-output read:g2026 read:g2027 read:i2027 read:igrade",
    "match:g": "node scripts/match-neis.mjs 경기 2027",
    "match:i": "node scripts/assign-incheon-areas.mjs 2027",
    "match:all": "run-p --print-label --aggregate-output match:g match:i",
    "checks": "run-p --print-label --aggregate-output selftest guard selftest:eslint-glob",
    "selftest:deployment": "node --test lib/deployment.test.mjs",
    "selftest:eslint-glob": "node --test scripts/selftest-eslint-glob.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^1.33.0",
    "next": "~16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/navermaps": "^3.9.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.3.8",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "fast-glob": "file:tools/next-eslint-glob"
  },
  "license": "MIT",
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    }
  }
}
